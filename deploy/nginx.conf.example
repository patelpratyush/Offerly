# Include inside nginx's http context. Replace domain and certificate paths.
# The app and proxy run on the same host; Node remains bound to loopback.
limit_req_zone $binary_remote_addr zone=offerly_per_ip:10m rate=10r/s;
server {
    listen 80;
    server_name offerly.example.com;
    return 308 https://offerly.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name offerly.example.com;
    ssl_certificate /etc/letsencrypt/live/offerly.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/offerly.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 28m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    limit_req zone=offerly_per_ip burst=30 nodelay;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host offerly.example.com;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite, never append untrusted client forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
