# Set these in your deployment service; npm start does not load this file automatically.
# APP_ORIGIN must exactly match the browser origin: HTTPS, no path or trailing slash.
APP_ORIGIN=https://offerly.example.com
DATABASE_PATH=/var/lib/offerly/offerly.sqlite
PORT=3001
# Enable only when a reverse proxy on loopback overwrites forwarded headers.
TRUST_PROXY_LOOPBACK=true
# Leave unset to disable new registrations. Use a random secret of at least 32 characters.
# REGISTRATION_TOKEN=
# Uploads are disabled in production until this local ClamAV daemon is configured.
# CLAMAV_SOCKET=/run/clamav/clamd.ctl

# Vercel + Supabase: set server-side only, never prefix with VITE_.
# DATABASE_URL=postgresql://offerly_app.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Use the transaction pooler URL without sslmode/ssl query parameters.
# TLS certificate verification is enforced by the server adapter.
# CRON_SECRET=  # random secret of at least 32 characters
