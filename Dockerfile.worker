# Always-on background worker (Gmail sync, recruiting jobs, reminders, discovery).
# The Vercel deployment serves the API only; run this image on any long-running
# host (Render, Railway, Fly) against the same Postgres database.
FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server ./server
USER node
CMD ["node", "server/worker.js"]
