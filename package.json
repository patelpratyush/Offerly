{
  "name": "offerly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test --project=desktop && playwright test --project=mobile",
    "format": "prettier --write src server tests",
    "lint": "eslint server api scripts tests *.config.js",
    "test:security": "node --test tests/security.test.js",
    "check": "npm run lint && npm test && npm run build && npm audit --audit-level=moderate",
    "db:backup": "node server/backup.js backup",
    "db:restore": "node server/backup.js restore",
    "test:postgres": "node --input-type=module -e \"if (!process.env.TEST_DATABASE_URL) throw new Error('TEST_DATABASE_URL required')\" && node --test --test-concurrency=1 tests/database.test.js tests/api.test.js tests/recruiting.test.js tests/document-usage.test.js tests/tracker-completion.test.js tests/tracker-fields.test.js tests/scheduler.test.js tests/file-lifecycle.test.js tests/hosted-files.test.js tests/scanner-maintenance.test.js tests/recovery.test.js",
    "scheduler:setup": "node --env-file=.env server/scheduler-admin.js setup",
    "scheduler:status": "node --env-file=.env server/scheduler-admin.js status",
    "scheduler:pause": "node --env-file=.env server/scheduler-admin.js pause",
    "scanner:refresh": "node --env-file=.env --env-file=.env.local server/scanner-admin.js refresh",
    "scanner:status": "node --env-file=.env --env-file=.env.local server/scanner-admin.js status",
    "phase0:sources": "node scripts/phase0-sources.js",
    "phase0:gmail": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/phase0-gmail-readiness.js",
    "phase0:model": "node scripts/phase0-model.js",
    "phase0:test": "node --test tests/job-sources.test.js tests/phase0-evaluation.test.js tests/phase0-readiness.test.js tests/phase0-model.test.js tests/phase0-reasoning.test.js tests/recruiting-match-guard.test.js tests/phase0-gmail.test.js tests/gmail-keychain.test.js tests/phase0-import-proof.test.js",
    "phase0:gmail:live": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/phase0-gmail.js",
    "phase0:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/phase0-import-proof.js",
    "phase0:valid-metrics": "node scripts/phase0-valid-only-metrics.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vercel/blob": "2.8.2",
    "@vercel/sandbox": "3.8.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.468.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
