{
  "name": "offerly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests",
    "lint": "eslint server tests *.config.js",
    "test:security": "node --test tests/security.test.js",
    "check": "npm run lint && npm test && npm run build && npm audit --audit-level=moderate",
    "db:backup": "node server/backup.js backup",
    "db:restore": "node server/backup.js restore"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
